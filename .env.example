# 复制成 .env 再填自己的值；只有填了的通道才会推送，可以填多个互相兜底。
# 这个文件不要提交到公开仓库（.gitignore 已经挡住 .env 了）。

# --- 选填：GitHub API 令牌，能让抓取配额从 10 次/分钟 提到 30 次/分钟 ---
# 不填也能跑，只是候选池小一点
GITHUB_TOKEN=

# --- 手机推送：任选一个或多个 ---

# 方案 A：ntfy（安卓/iOS 都有 App，免费、不用注册，最省事）
# 手机装 ntfy → 订阅一个只有你知道的话题名（越随机越好）→ 填到这里
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# 方案 B：Bark（iPhone 专用，装 App 后把那串 key 填进来）
# 直接粘贴 App 里复制的整条地址（https://api.day.app/xxxxx）也行
BARK_KEY=
# 自建 Bark 服务器时才需要改这个
# BARK_SERVER=https://api.day.app
# 通知级别：timeSensitive 能穿透专注模式/静音（需在 iOS 设置里允许时效性通知）
# BARK_LEVEL=timeSensitive

# 方案 C：PushPlus（微信收提醒，网页扫码登录后拿 token）
PUSHPLUS_TOKEN=

# 方案 D：Server酱（微信收提醒）
SERVERCHAN_KEY=

# 方案 E：飞书 / 企业微信 / 钉钉 群机器人（想在群里留档就用这个）
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=

# 方案 F：Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 方案 G：邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# --- 其它 ---
# 推送时间显示用哪个时区（默认 +8 北京时间）
TZ_OFFSET=8
